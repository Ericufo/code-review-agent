DEEPSEEK_API_KEY=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Optional API/PostgreSQL settings; CLI does not require these.
# Set in the process environment before running: python -m alembic upgrade head
DATABASE_URL=

# Required for API startup. Single trusted caller group, not per-user tenancy.
REVIEW_API_TOKEN=
REVIEW_ALLOWED_REPOS=
# Mock disables model charges, but the normal server still reads GitHub.
REVIEW_MODEL_MODE=mock
# Named budget overrides, e.g. {"default":{"max_files":10,"max_model_calls":20}}
REVIEW_PROFILES_JSON={}
REVIEW_WAITING_LIMIT=8
REVIEW_GITHUB_TIMEOUT=10
REVIEW_MODEL_TIMEOUT=45
REVIEW_MAX_OUTPUT_TOKENS=16384
REVIEW_SHUTDOWN_GRACE=10
