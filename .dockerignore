# Deny by default: credentials, Git history, local notes and test fixtures never enter the build context.
**
!Dockerfile
!.dockerignore
!requirements.txt
!requirements-api.txt
!context_review.py
!diff_parser.py
!git_utils.py
!github_client.py
!github_comment.py
!github_diff.py
!github_review.py
!main.py
!repository_context.py
!review_checkpoint.py
!review_events.py
!review_formatter.py
!review_graph.py
!review_models.py
!review_pipeline.py
!review_service.py
!review_tools.py
!reviewer.py
!alembic.ini
!review_api/
review_api/**
!review_api/*.py
!migrations/
migrations/**
!migrations/*.py
!migrations/*.mako
!migrations/versions/
migrations/versions/**
!migrations/versions/*.py
# Directory re-inclusion must never re-admit caches or credentials.
**/__pycache__
**/*.py[cod]
**/.env*
